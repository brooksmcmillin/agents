#!/usr/bin/env bash
#
# install-weekly-review-timer - Install a weekly systemd timer for weekly-pr-review.
#
# Idempotent: safe to run multiple times. Will not overwrite an existing timer.
#
# Usage:
#   install-weekly-review-timer <directory> <category> <day-of-week> <HH:MM>
#
# Examples:
#   install-weekly-review-timer ~/build/agents "PR Review" monday 09:00
#   install-weekly-review-timer ~/build/agents "PR Review" mon 09:00
#   install-weekly-review-timer ~/build/agents "PR Review" 1 09:00
#
# To list installed timers:
#   systemctl list-timers 'weekly-pr-review*'
#
# To remove:
#   sudo systemctl disable --now weekly-pr-review-<slug>.timer
#   sudo rm /etc/systemd/system/weekly-pr-review-<slug>.{service,timer}
#   sudo systemctl daemon-reload
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REVIEW_SCRIPT="$SCRIPT_DIR/weekly-pr-review"
ENV_FILE="$(dirname "$SCRIPT_DIR")/.env"

usage() {
  cat <<'EOF'
Usage: install-weekly-review-timer <directory> <category> <day-of-week> <HH:MM>

Install a weekly systemd timer that runs weekly-pr-review on the given directory.

Arguments:
  directory     Path to the git repository to review
  category      TaskManager category/project name (quote if it has spaces)
  day-of-week   Day to run: name (monday, mon) or number (0-6, 0=Sunday)
  HH:MM         Time to run in 24-hour format (e.g., 09:00, 15:30)

Options:
  -h, --help    Show this help

Day-of-week accepts:
  Names:   sunday, monday, tuesday, wednesday, thursday, friday, saturday
  Short:   sun, mon, tue, wed, thu, fri, sat
  Numbers: 0=Sunday, 1=Monday, ..., 6=Saturday

Only one timer is allowed per directory. Re-running with the same
directory will report the existing timer and exit without changes.

Examples:
  install-weekly-review-timer ~/build/agents "PR Review" monday 09:00
  install-weekly-review-timer ~/build/agents "PR Review" fri 14:00
  install-weekly-review-timer ~/build/taskmanager "Security" 3 10:00
EOF
  exit 0
}

# --- Parse day-of-week to systemd OnCalendar format ---
parse_day_of_week() {
  local input="${1,,}"  # lowercase
  case "$input" in
    0|sunday|sun)     echo "Sun" ;;
    1|monday|mon)     echo "Mon" ;;
    2|tuesday|tue)    echo "Tue" ;;
    3|wednesday|wed)  echo "Wed" ;;
    4|thursday|thu)   echo "Thu" ;;
    5|friday|fri)     echo "Fri" ;;
    6|saturday|sat)   echo "Sat" ;;
    *)
      echo "Error: invalid day-of-week '$1'" >&2
      echo "Accepted: sunday/sun/0, monday/mon/1, tuesday/tue/2, wednesday/wed/3, thursday/thu/4, friday/fri/5, saturday/sat/6" >&2
      return 1
      ;;
  esac
}

day_name() {
  local input="${1,,}"
  case "$input" in
    0|sunday|sun)     echo "Sunday" ;;
    1|monday|mon)     echo "Monday" ;;
    2|tuesday|tue)    echo "Tuesday" ;;
    3|wednesday|wed)  echo "Wednesday" ;;
    4|thursday|thu)   echo "Thursday" ;;
    5|friday|fri)     echo "Friday" ;;
    6|saturday|sat)   echo "Saturday" ;;
  esac
}

# --- Parse args ---
[[ $# -eq 0 ]] && usage
[[ "$1" == "-h" || "$1" == "--help" ]] && usage

if [[ $# -lt 4 ]]; then
  echo "Error: expected 4 arguments: <directory> <category> <day-of-week> <HH:MM>" >&2
  echo "Run with --help for usage." >&2
  exit 1
fi

TARGET_DIR="$1"
CATEGORY="$2"
DAY_OF_WEEK_INPUT="$3"
TIME="$4"

# --- Validate day-of-week ---
DOW_SYSTEMD=$(parse_day_of_week "$DAY_OF_WEEK_INPUT") || exit 1
DOW_NAME=$(day_name "$DAY_OF_WEEK_INPUT")

# --- Validate time format ---
if ! [[ "$TIME" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then
  echo "Error: time must be HH:MM in 24-hour format (e.g., 09:00, 15:30), got '$TIME'" >&2
  exit 1
fi

# --- Validate category (reject shell-special characters and control chars) ---
if [[ "$CATEGORY" =~ [\"\$\`\\%] ]] || [[ "$CATEGORY" == *$'\n'* ]] || [[ "$CATEGORY" == *$'\r'* ]]; then
  echo "Error: category name must not contain double quotes, dollar signs, backticks, backslashes, percent signs, or newlines" >&2
  exit 1
fi

# --- Validate directory ---
TARGET_DIR=$(realpath "$TARGET_DIR" 2>/dev/null || echo "$TARGET_DIR")
if [[ ! -d "$TARGET_DIR" ]]; then
  echo "Error: directory does not exist: $TARGET_DIR" >&2
  exit 1
fi

# --- Validate weekly-pr-review script ---
if [[ ! -f "$REVIEW_SCRIPT" ]]; then
  echo "Error: weekly-pr-review not found at $REVIEW_SCRIPT" >&2
  exit 1
fi

if [[ ! -x "$REVIEW_SCRIPT" ]]; then
  echo "Error: weekly-pr-review is not executable. Run: chmod +x $REVIEW_SCRIPT" >&2
  exit 1
fi

# --- Validate .env ---
if [[ ! -f "$ENV_FILE" ]]; then
  echo "Error: $ENV_FILE not found. Copy .env.example to .env and configure it." >&2
  exit 1
fi

if ! grep -qE '^\s*NTFY_TOKEN=.+' "$ENV_FILE"; then
  echo "Error: NTFY_TOKEN not found (or commented out) in $ENV_FILE." >&2
  exit 1
fi

# --- Derive unit name from directory basename ---
DIR_SLUG=$(basename "$TARGET_DIR" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g; s/--*/-/g; s/^-//; s/-$//')
UNIT_NAME="weekly-pr-review-${DIR_SLUG}"

# --- Check for existing timer ---
if systemctl list-unit-files "${UNIT_NAME}.timer" &>/dev/null && \
   systemctl list-unit-files "${UNIT_NAME}.timer" 2>/dev/null | grep -q "${UNIT_NAME}.timer"; then
  echo "Timer already exists: ${UNIT_NAME}.timer. No changes made."
  systemctl list-timers "${UNIT_NAME}.timer" --no-pager 2>/dev/null || true
  exit 0
fi

# --- Generate service unit ---
SERVICE_CONTENT="[Unit]
Description=Weekly PR Review: ${CATEGORY} (${TARGET_DIR})
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=$(whoami)
WorkingDirectory=${TARGET_DIR}
ExecStart=${REVIEW_SCRIPT} ${TARGET_DIR} -c \"${CATEGORY}\"
EnvironmentFile=${ENV_FILE}
Environment=PATH=${HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target"

# --- Generate timer unit ---
TIMER_CONTENT="[Unit]
Description=Run weekly-pr-review ${DOW_NAME}s at ${TIME} for ${TARGET_DIR}

[Timer]
OnCalendar=${DOW_SYSTEMD} *-*-* ${TIME}:00
Persistent=true

[Install]
WantedBy=timers.target"

# --- Install ---
echo "Installing ${UNIT_NAME}.service and ${UNIT_NAME}.timer..."

echo "$SERVICE_CONTENT" | sudo tee "/etc/systemd/system/${UNIT_NAME}.service" >/dev/null
echo "$TIMER_CONTENT" | sudo tee "/etc/systemd/system/${UNIT_NAME}.timer" >/dev/null

sudo systemctl daemon-reload
sudo systemctl enable --now "${UNIT_NAME}.timer"

echo ""
echo "Timer installed:"
echo "  Unit:      ${UNIT_NAME}.timer"
echo "  Schedule:  ${DOW_NAME}s at ${TIME}"
echo "  Directory: ${TARGET_DIR}"
echo "  Category:  ${CATEGORY}"
echo ""
echo "Verify with:"
echo "  systemctl list-timers '${UNIT_NAME}*'"
echo "  journalctl -u ${UNIT_NAME}.service"
echo ""
echo "To remove:"
echo "  sudo systemctl disable --now ${UNIT_NAME}.timer"
echo "  sudo rm /etc/systemd/system/${UNIT_NAME}.{service,timer}"
echo "  sudo systemctl daemon-reload"
