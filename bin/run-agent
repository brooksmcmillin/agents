#!/usr/bin/env python3
"""CLI runner for individual agents.

Usage:
    uv run python bin/run-agent pr                    # Run PR agent interactively
    uv run python bin/run-agent pr "Your message"    # Run once with message and exit
    uv run python bin/run-agent tasks                 # Run Task Manager agent
    uv run python bin/run-agent --list                # List available agents
    uv run python bin/run-agent pr --resume last      # Resume most recent PR session
    uv run python bin/run-agent pr --resume <id>      # Resume a specific session
    uv run python bin/run-agent --sessions            # List all saved sessions
    uv run python bin/run-agent --sessions pr         # List sessions for PR agent
"""

import argparse
import asyncio
import sys
from pathlib import Path

# Ensure project root is on sys.path so `shared` is importable regardless of
# how the script is invoked (e.g. `python bin/run-agent` sets sys.path[0] to bin/).
_project_root = str(Path(__file__).resolve().parent.parent)
if _project_root not in sys.path:
    sys.path.insert(0, _project_root)

from agent_framework.core.session import SessionStore  # noqa: E402
from agent_framework.permissions.context import ExecutionContext  # noqa: E402
from agent_framework.permissions.identity import AgentIdentity  # noqa: E402
from agent_framework.permissions.permissions import Permission, PermissionSet  # noqa: E402

from shared import (  # noqa: E402
    GITHUB_MCP_AGENTS,
    build_agent_registry,
    github_mcp_config,
    run_agent,
)

# Build registry lazily — agent imports happen here, not at module scope.
AGENTS = build_agent_registry()


def list_agents() -> None:
    """Print available agents."""
    print("Available agents:")
    for name, (_, _, desc) in AGENTS.items():
        print(f"  • {name:15s} {desc}")


def list_sessions(agent_name: str | None = None) -> None:
    """Print saved sessions, optionally filtered by agent name."""
    store = SessionStore()
    sessions = store.list_sessions(agent_name=agent_name, limit=30)

    if not sessions:
        if agent_name:
            print(f"No saved sessions for '{agent_name}'.")
        else:
            print("No saved sessions.")
        return

    header = f"Saved sessions for '{agent_name}'" if agent_name else "All saved sessions"
    print(f"\n{header}:")
    print(f"  {'SESSION ID':<35s} {'AGENT':<18s} {'TURNS':<8s} {'TOKENS':<12s} {'UPDATED'}")
    print(f"  {'-' * 35} {'-' * 18} {'-' * 8} {'-' * 12} {'-' * 20}")

    for s in sessions:
        total_tokens = s["total_input_tokens"] + s["total_output_tokens"]
        updated = s.get("updated_at", "")[:19].replace("T", " ")
        print(
            f"  {s['session_id']:<35s} {s['agent_name']:<18s} "
            f"{s['messages']:<8d} {total_tokens:<12,d} {updated}"
        )

    print("\nResume a session with: uv run python bin/run-agent <agent> --resume <session-id>")
    print("Resume the latest with: uv run python bin/run-agent <agent> --resume last")


def parse_permissions(raw: str) -> PermissionSet:
    """Parse a comma-separated permission string into a PermissionSet.

    Args:
        raw: Comma-separated permission names (e.g. "READ,SEND")

    Returns:
        PermissionSet with the specified permissions
    """
    valid = {p.name: p for p in Permission}
    perms: list[Permission] = []
    for name in raw.split(","):
        name = name.strip().upper()
        if name not in valid:
            raise ValueError(f"Unknown permission {name!r}. Valid: {', '.join(valid)}")
        perms.append(valid[name])
    return PermissionSet(perms)


async def run_once(
    agent_class: type,
    agent_kwargs: dict | None,
    message: str,
    quiet: bool = False,
    execution_context: ExecutionContext | None = None,
) -> None:
    """Run an agent with a single message and exit.

    Args:
        agent_class: Agent class to instantiate
        agent_kwargs: Keyword arguments to pass to agent constructor
        message: The message to send to the agent
        quiet: If True, suppress status messages (only show response)
        execution_context: Optional execution context with permission constraints
    """
    try:
        agent = agent_class(**(agent_kwargs or {}))

        if not quiet:
            print(f"Running {agent_class.__name__}...\n")

        streamed = False

        def _stream_delta(text: str) -> None:
            nonlocal streamed
            streamed = True
            sys.stdout.write(text)
            sys.stdout.flush()

        def _show_tool_status(tool_name: str) -> None:
            nonlocal streamed
            if streamed:
                sys.stdout.write("\n")
            sys.stdout.write(f"  [calling {tool_name}...]\n")
            sys.stdout.flush()
            streamed = False

        await agent.process_message(
            message,
            execution_context=execution_context,
            on_text_delta=_stream_delta,
            on_tool_start=_show_tool_status,
        )
        if streamed:
            print()  # trailing newline after streamed output

        if not quiet:
            print("---")
            print(
                f"Tokens: {agent.total_input_tokens:,} input, {agent.total_output_tokens:,} output"
            )

    except ValueError as e:
        print(f"\nConfiguration error: {e}", file=sys.stderr)
        print("\nPlease ensure:", file=sys.stderr)
        print("1. You have a .env file with ANTHROPIC_API_KEY set", file=sys.stderr)
        print("2. The API key is valid", file=sys.stderr)
        sys.exit(1)

    except Exception as e:
        print(f"\nError: {e}", file=sys.stderr)
        sys.exit(1)


async def main() -> None:
    """Parse arguments and run the specified agent."""
    parser = argparse.ArgumentParser(
        description="Run a specific agent from the command line.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
    uv run python bin/run-agent pr                        # Interactive mode
    uv run python bin/run-agent pr "Analyze my website"  # One-off execution
    uv run python bin/run-agent chatbot "Hello!"         # Quick question
    uv run python bin/run-agent --list                    # List available agents

Session management:
    uv run python bin/run-agent --sessions               # List all saved sessions
    uv run python bin/run-agent --sessions pr            # List PR agent sessions
    uv run python bin/run-agent pr --resume last         # Resume most recent session
    uv run python bin/run-agent pr --resume <session-id> # Resume specific session

One-off mode:
    When a MESSAGE is provided, the agent processes it once and exits.
    This is useful for scripting, automation, and quick tasks.

    # Quiet mode for scripting (only outputs the response)
    uv run python bin/run-agent pr -q "Summarize this doc"

    # Pipe output to other commands
    uv run python bin/run-agent pr -q "List 5 blog ideas" | head -10
""",
    )
    parser.add_argument(
        "agent",
        nargs="?",
        choices=list(AGENTS.keys()),
        help="Agent to run",
    )
    parser.add_argument(
        "message",
        nargs="?",
        help="Message to send (if provided, runs once and exits)",
    )
    parser.add_argument(
        "--list",
        "-l",
        action="store_true",
        help="List available agents",
    )
    parser.add_argument(
        "--sessions",
        nargs="?",
        const="__all__",
        metavar="AGENT",
        help="List saved sessions. Optionally filter by agent name.",
    )
    parser.add_argument(
        "--resume",
        "-r",
        metavar="SESSION_ID",
        help="Resume a previous session by ID, or use 'last' to resume the most recent.",
    )
    parser.add_argument(
        "--quiet",
        "-q",
        action="store_true",
        help="Quiet mode: only output the agent's response (for scripting)",
    )
    parser.add_argument(
        "--permissions",
        "-p",
        help="Comma-separated permissions (e.g. READ,SEND). Limits what tools the agent can use.",
    )
    parser.add_argument(
        "--skip-failed-mcp",
        action="store_true",
        help="Skip remote MCP servers that fail to connect (e.g., due to OAuth) instead of blocking.",
    )

    args = parser.parse_args()

    if args.list:
        list_agents()
        return

    if args.sessions is not None:
        agent_filter = None if args.sessions == "__all__" else args.sessions
        list_sessions(agent_filter)
        return

    if not args.agent:
        parser.print_help()
        sys.exit(1)

    agent_class, agent_kwargs, _ = AGENTS[args.agent]

    # Build GitHub MCP config lazily so --list works without GITHUB_MCP_PAT
    if args.agent in GITHUB_MCP_AGENTS:
        agent_kwargs = github_mcp_config()

    # Inject skip_failed_mcp_urls into agent kwargs if flag is set
    if args.skip_failed_mcp:
        agent_kwargs = dict(agent_kwargs or {})
        agent_kwargs["skip_failed_mcp_urls"] = True

    # Build execution context if --permissions specified
    execution_context = None
    if args.permissions:
        perm_set = parse_permissions(args.permissions)
        execution_context = ExecutionContext(
            caller=AgentIdentity(name=agent_class.__name__, source="cli"),
            permissions=perm_set,
        )

    if args.message:
        # One-off mode: process single message and exit
        if args.resume:
            print(
                "Warning: --resume is not supported in one-off mode (with a message).",
                file=sys.stderr,
            )
        await run_once(
            agent_class,
            agent_kwargs,
            args.message,
            quiet=args.quiet,
            execution_context=execution_context,
        )
    else:
        # Interactive mode (--permissions only applies to one-off mode)
        if execution_context:
            print(
                "Warning: --permissions is only supported in one-off mode (with a message).",
                file=sys.stderr,
            )
        print(f"Starting {args.agent} agent...")
        await run_agent(agent_class, agent_kwargs, session_id=args.resume)


if __name__ == "__main__":
    asyncio.run(main())
