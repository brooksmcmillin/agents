#!/usr/bin/env bash
set -euo pipefail

# Blog Post Ideas: Search merged PRs across all repos via GitHub MCP and generate
# blog post ideas, biased towards AI/LLM Security but open to other topics.
#
# Uses GitHub MCP tools (mcp__github__*) to discover and analyze PRs rather than
# requiring a specific repository. Creates a wiki page documenting the ideas.
#
# Usage:
#   blog-post-ideas -c "Blog Ideas"
#   blog-post-ideas -c "Blog Ideas" --days 30
#
# Designed for cron/systemd timers. Sends ntfy alerts on any failure.

SCRIPT_NAME="blog-post-ideas"
CREDENTIALS_FILE="${HOME}/.claude/.credentials.json"
NTFY_URL="https://ntfy.brooksmcmillin.com/mcp-alerts"
HOSTNAME="$(hostname 2>/dev/null || cat /etc/hostname 2>/dev/null || echo 'unknown')"
TODAY=$(date +%Y-%m-%d)
NOW_TIME=$(date +%H:%M)

# Load NTFY_TOKEN from .env if not already set (co-located with the script)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
PROJECT_ENV="${PROJECT_DIR}/.env"
if [[ -z "${NTFY_TOKEN:-}" && -f "$PROJECT_ENV" ]]; then
  NTFY_TOKEN=$(grep -m1 '^NTFY_TOKEN=' "$PROJECT_ENV" 2>/dev/null | cut -d= -f2- || true)
fi

# --- Alert helper: send push notification on failure ---
send_alert() {
  local title="$1" message="$2" priority="${3:-high}"
  if [[ -z "${NTFY_TOKEN:-}" ]]; then
    echo "Warning: NTFY_TOKEN not set, cannot send alert: $title" >&2
    return 0
  fi
  curl -sf --max-time 10 \
    -H "Authorization: Bearer ${NTFY_TOKEN}" \
    -H "Title: $title" \
    -H "Priority: $priority" \
    -H "Tags: warning" \
    -d "$message" \
    "$NTFY_URL" >/dev/null 2>&1 || echo "Warning: failed to send ntfy alert" >&2
}

usage() {
  cat <<'EOF'
Usage: blog-post-ideas [options]

Search merged PRs across all your GitHub repos and generate blog post
ideas, biased towards AI/LLM Security but covering other interesting
topics too.

Uses GitHub MCP tools to discover PRs — no specific repo required.
Creates a wiki page documenting the ideas.

Options:
  -c, --category NAME   TaskManager project/category (required)
  --days N              Number of days to look back (default: 14)
  -d, --dry-run         Print the claude command without running it
  -h, --help            Show this help

Examples:
  blog-post-ideas -c "Blog Ideas"
  blog-post-ideas -c "Blog Ideas" --days 30
  blog-post-ideas -c "Blog Ideas" --dry-run
EOF
  exit 0
}

# --- Preflight: verify required commands ---
check_prerequisites() {
  local missing=()
  for cmd in claude python3 curl; do
    if ! command -v "$cmd" &>/dev/null; then
      missing+=("$cmd")
    fi
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    local msg="Missing required commands: ${missing[*]}"
    send_alert "$SCRIPT_NAME: Missing Dependencies [$HOSTNAME]" "$msg"
    echo "Error: $msg" >&2
    exit 1
  fi
}

# --- Preflight: verify TaskManager MCP OAuth token ---
check_mcp_token() {
  if [[ ! -f "$CREDENTIALS_FILE" ]]; then
    send_alert "$SCRIPT_NAME: Credentials Missing [$HOSTNAME]" \
      "Credentials file not found at $CREDENTIALS_FILE on $HOSTNAME."
    echo "Error: credentials file not found at $CREDENTIALS_FILE" >&2
    return 1
  fi

  local token_info
  token_info=$(python3 - "$CREDENTIALS_FILE" <<'PYEOF'
import json, sys
creds = json.load(open(sys.argv[1]))
for key, val in creds.get("mcpOAuth", {}).items():
    if val.get("serverName") == "taskmanager":
        print(val.get("accessToken", ""))
        print(val.get("expiresAt", "0"))
        sys.exit(0)
sys.exit(1)
PYEOF
  ) || {
    send_alert "$SCRIPT_NAME: No Token [$HOSTNAME]" \
      "No taskmanager OAuth token found in credentials on $HOSTNAME. Run mcp-device-auth.sh."
    echo "Error: no taskmanager token in credentials" >&2
    return 1
  }

  local access_token expires_at now_ms buffer_ms
  access_token=$(echo "$token_info" | sed -n '1p')
  expires_at=$(echo "$token_info" | sed -n '2p')
  now_ms=$(($(date +%s) * 1000))

  if [[ -z "$access_token" ]]; then
    send_alert "$SCRIPT_NAME: Empty Token [$HOSTNAME]" \
      "TaskManager access token is empty on $HOSTNAME. Re-authenticate."
    echo "Error: taskmanager access token is empty" >&2
    return 1
  fi

  buffer_ms=$((5 * 60 * 1000))
  if (( now_ms + buffer_ms > expires_at )); then
    send_alert "$SCRIPT_NAME: Token Expired [$HOSTNAME]" \
      "TaskManager OAuth token expired or expiring within 5 min on $HOSTNAME. Re-authenticate at https://mcp-auth.brooksmcmillin.com/" "urgent"
    echo "Error: taskmanager OAuth token is expired or expiring within 5 minutes" >&2
    return 1
  fi

  # Validate token against introspection endpoint
  local introspect_result active
  introspect_result=$(printf 'token=%s' "$access_token" | \
    curl -sf --max-time 10 \
    -X POST "https://mcp-auth.brooksmcmillin.com/introspect" \
    --data-binary @- 2>/dev/null) || {
    echo "Warning: could not reach introspection endpoint, trusting local expiry" >&2
    return 0
  }

  active=$(echo "$introspect_result" | python3 -c "import json,sys; print(json.load(sys.stdin).get('active', False))" 2>/dev/null)
  if [[ "$active" != "True" ]]; then
    send_alert "$SCRIPT_NAME: Token Revoked [$HOSTNAME]" \
      "TaskManager OAuth token is revoked or invalid on $HOSTNAME (introspection: active=false). Re-authenticate." "urgent"
    echo "Error: taskmanager OAuth token is revoked or invalid" >&2
    return 1
  fi

  return 0
}

# --- Parse args ---
[[ $# -eq 0 ]] && usage
[[ "$1" == "-h" || "$1" == "--help" ]] && usage

CATEGORY=""
DAYS=14
DRY_RUN=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -c|--category)  CATEGORY="$2"; shift 2 ;;
    --days)         DAYS="$2"; shift 2 ;;
    -d|--dry-run)   DRY_RUN=true; shift ;;
    -h|--help)      usage ;;
    *)              echo "Unknown option: $1" >&2; usage ;;
  esac
done

if [[ -z "$CATEGORY" ]]; then
  echo "Error: --category is required" >&2
  exit 1
fi

if ! [[ "$DAYS" =~ ^[1-9][0-9]*$ ]]; then
  echo "Error: --days must be a positive integer, got '$DAYS'" >&2
  exit 1
fi

# --- Preflight checks ---
check_prerequisites

if ! $DRY_RUN; then
  if ! check_mcp_token; then
    exit 1
  fi
fi

# --- Compute date range ---
SINCE_DATE=$(date -d "-${DAYS} days" +%Y-%m-%d 2>/dev/null || date -v-${DAYS}d +%Y-%m-%d)

# --- Compute slugs for wiki page ---
CATEGORY_SLUG=$(echo "$CATEGORY" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g; s/--*/-/g; s/^-//; s/-$//')

WIKI_ROOT_SLUG="automation-log"
WIKI_ROOT_TITLE="Automation Log"
WIKI_CAT_SLUG="${CATEGORY_SLUG}"
WIKI_CAT_TITLE="${CATEGORY}"
WIKI_DATE_SLUG="${CATEGORY_SLUG}-${TODAY}-${NOW_TIME//:}"
WIKI_DATE_TITLE="${CATEGORY} (${TODAY} ${NOW_TIME})"

# --- Build prompt ---
PROMPT_FILE=$(mktemp "${TMPDIR:-/tmp}/${SCRIPT_NAME}-prompt.XXXXXX")

cat > "$PROMPT_FILE" <<PROMPT_VARS
You are a technical blog strategist analyzing recent merged pull requests for content opportunities.

**Period:** ${SINCE_DATE} to ${TODAY} (${DAYS} days)

## Step 1: Discover PRs

Use the GitHub MCP tools to find merged PRs from the last ${DAYS} days:

1. First, call \`mcp__github__get_me\` to get your GitHub username.
2. Then, call \`mcp__github__search_pull_requests\` with query \`is:merged author:@me merged:>=${SINCE_DATE}\` to find all your merged PRs across all repositories.
3. For interesting PRs, use \`mcp__github__pull_request_read\` (method: "get" or "get_files") to get details and file lists.
4. To read specific files in a repo, use \`mcp__github__get_file_contents\`.
5. To understand commit history, use \`mcp__github__list_commits\` or \`mcp__github__get_commit\`.

Search across ALL your repos — do not limit to a single repository.
PROMPT_VARS

cat >> "$PROMPT_FILE" <<'PROMPT_STATIC'

## Step 2: Analyze and Generate Ideas

Once you have the PR data, generate compelling blog post ideas. You should:

1. **Examine the code** when a PR looks interesting — don't just rely on titles and descriptions. Use `mcp__github__get_file_contents` and `mcp__github__pull_request_read` (method: "get_files" or "get_diff") to understand actual implementations, design decisions, and tradeoffs.
2. **Prioritize AI/LLM Security topics** — this is the primary content area. Look for:
   - Prompt injection defenses, input sanitization, or output filtering
   - MCP server security patterns (auth, SSRF protection, tool sandboxing)
   - Agent safety patterns (iteration limits, tool allowlists, error containment)
   - OAuth/auth flows for AI tool access
   - Red team or security audit tooling
   - Trust boundaries in multi-agent systems
   - Supply chain concerns for AI tools and plugins
   - Any novel attack/defense patterns
3. **Other good topics are welcome** — automation, developer tooling, architecture patterns, DevOps, testing strategies, etc. Don't force an AI security angle where there isn't one.

## Output Format

Produce a structured analysis with these sections:

### Summary
Brief overview: how many PRs reviewed across how many repos, dominant themes, overall content potential.

### Blog Post Ideas

For each idea (aim for 3-8 ideas, quality over quantity):

#### [Idea Number]. [Working Title]
- **Hook**: 1-2 sentence pitch that would grab a technical reader
- **Source PRs**: Which PR(s) inspired this idea (repo, number, title, URL)
- **Key Technical Points**: 3-5 bullet points covering what the post would explain
- **Target Audience**: Who would read this (security engineers, AI developers, DevOps, etc.)
- **Content Type**: Tutorial / Deep Dive / Opinion / Case Study / How-To
- **Estimated Depth**: Short (800-1200 words) / Medium (1500-2500 words) / Long (3000+ words)
- **AI Security Relevance**: High / Medium / Low / None — brief explanation of the security angle if any

### Content Calendar Suggestion
Order the ideas by timeliness and impact. Note any that tie into current industry conversations or upcoming events.

### Raw Material Notes
For each promising idea, note specific code snippets, commit messages, or implementation details worth referencing in the actual blog post. This saves time when writing.

## Important

Do NOT create or modify any files or PRs. This is a read-only analysis.
PROMPT_STATIC

PROMPT=$(cat "$PROMPT_FILE")
rm -f "$PROMPT_FILE"

# --- Allowed tools: GitHub MCP (read-only) ---
ALLOWED_TOOLS=(
  # GitHub MCP — PR discovery and code reading
  "mcp__github__get_me"
  "mcp__github__search_pull_requests"
  "mcp__github__pull_request_read"
  "mcp__github__get_file_contents"
  "mcp__github__list_commits"
  "mcp__github__get_commit"
  "mcp__github__search_code"
  "mcp__github__search_repositories"
)

SESSION_ID=$(python3 -c "import uuid; print(uuid.uuid4())")
CMD_ARGS=(claude -p - --allowedTools "${ALLOWED_TOOLS[@]}" --session-id "$SESSION_ID")

if $DRY_RUN; then
  echo "Would run (from $PROJECT_DIR):"
  echo ""
  echo "Period: $SINCE_DATE to $TODAY ($DAYS days)"
  echo "Wiki slug:  ${WIKI_ROOT_SLUG}/${WIKI_CAT_SLUG}/${WIKI_DATE_SLUG}"
  echo "Wiki title: ${WIKI_DATE_TITLE}"
  echo ""
  echo "Prompt length: $(echo "$PROMPT" | wc -c) bytes"
  printf "  %q" "${CMD_ARGS[@]}"
  echo ""
  exit 0
fi

echo "$(date -Iseconds) Starting $SCRIPT_NAME: category=${CATEGORY}, days=${DAYS}, since=${SINCE_DATE}"

# Run claude from the project directory (no specific repo needed)
cd "$PROJECT_DIR"

# --- Phase 1: Run blog idea analysis (pipe prompt via stdin to avoid ARG_MAX) ---
EXIT_CODE=0
echo "$PROMPT" | "${CMD_ARGS[@]}" || EXIT_CODE=$?

if [[ $EXIT_CODE -ne 0 ]]; then
  send_alert "$SCRIPT_NAME: Claude Failed [$HOSTNAME]" \
    "claude -p exited with code $EXIT_CODE for category '${CATEGORY}' on $HOSTNAME. Check logs."
  echo "$(date -Iseconds) Error: claude exited with code $EXIT_CODE" >&2
fi

# --- Phase 2: Create wiki page from captured output ---
PROJECT_SLUG=$(printf '%s' "$PROJECT_DIR" | sed 's|/|-|g')
SESSION_JSONL="${HOME}/.claude/projects/${PROJECT_SLUG}/${SESSION_ID}.jsonl"

CAPTURED_OUTPUT=""
if [[ -f "$SESSION_JSONL" ]]; then
  CAPTURED_OUTPUT=$(python3 - "$SESSION_JSONL" <<'PYEOF'
import json, sys

texts = []
with open(sys.argv[1]) as f:
    for line in f:
        entry = json.loads(line)
        if entry.get("type") == "assistant":
            for block in entry.get("message", {}).get("content", []):
                if isinstance(block, dict) and block.get("type") == "text":
                    texts.append(block["text"])

print("\n".join(texts))
PYEOF
  )
  echo "$(date -Iseconds) Extracted output from session JSONL: ${SESSION_JSONL}"
else
  echo "$(date -Iseconds) Warning: session JSONL not found at ${SESSION_JSONL}" >&2
fi

if [[ -z "$CAPTURED_OUTPUT" ]]; then
  send_alert "$SCRIPT_NAME: No Output [$HOSTNAME]" \
    "No assistant text found in session JSONL for category '${CATEGORY}' on $HOSTNAME. Session: ${SESSION_ID}. Wiki page not created."
  echo "$(date -Iseconds) Warning: no output captured, skipping wiki page creation" >&2
else
  echo "$(date -Iseconds) Creating wiki page: ${WIKI_ROOT_SLUG}/${WIKI_CAT_SLUG}/${WIKI_DATE_SLUG}"

  # Sanitize captured output: strip any line that matches the heredoc delimiter
  CAPTURED_OUTPUT=$(echo "$CAPTURED_OUTPUT" | grep -vxF '_WIKI_PROMPT_END_')

  read -r -d '' WIKI_PROMPT <<_WIKI_PROMPT_END_ || true
Create a hierarchical wiki page in TaskManager to log blog post ideas generated from PR analysis.

The page structure is: automation-log / <category> / <date>

Follow these steps IN ORDER:

### Step 1: Ensure the root page exists
Search for a wiki page with slug "${WIKI_ROOT_SLUG}" using search_wiki_pages.
- If it does NOT exist, create it:
  - title: "${WIKI_ROOT_TITLE}"
  - slug: "${WIKI_ROOT_SLUG}"
  - content: "Index of automated sprint and code review runs."
- Note its page ID (from the search result or create response).

### Step 2: Ensure the category page exists
Search for a wiki page with slug "${WIKI_CAT_SLUG}" using search_wiki_pages.
- If it does NOT exist, create it:
  - title: "${WIKI_CAT_TITLE}"
  - slug: "${WIKI_CAT_SLUG}"
  - parent_id: (the root page ID from step 1)
  - content: "Blog post ideas generated from PR analysis."
- Note its page ID.

### Step 3: Create or update the date page
Search for a wiki page with slug "${WIKI_DATE_SLUG}" using search_wiki_pages.
- If it exists AND is a child of the category page, update it with update_wiki_page.
- If it does NOT exist, create it:
  - title: "${WIKI_DATE_TITLE}"
  - slug: "${WIKI_DATE_SLUG}"
  - parent_id: (the category page ID from step 2)

### Step 4: Page content
Set the date page content based on the blog ideas output below.

Here is the raw output from the blog post idea generation:

---
${CAPTURED_OUTPUT}
---

Format the page content as clean markdown:

# Blog Post Ideas: ${CATEGORY} (${TODAY} ${NOW_TIME})

## Overview
- Period: ${SINCE_DATE} to ${TODAY} (${DAYS} days)
- Source: All merged PRs by the user across GitHub repos

Then include all sections from the output (Summary, Blog Post Ideas with all details, Content Calendar, Raw Material Notes).

Extract the actual data from the output above. Do not use placeholder values.
_WIKI_PROMPT_END_

  WIKI_TOOLS=(
    "mcp__taskmanager__search_wiki_pages"
    "mcp__taskmanager__create_wiki_page"
    "mcp__taskmanager__update_wiki_page"
  )

  WIKI_EXIT=0
  WIKI_ERR=$(mktemp "${TMPDIR:-/tmp}/${SCRIPT_NAME}-wiki-err.XXXXXX")
  claude -p "$WIKI_PROMPT" --model claude-haiku-4-5-20251001 --allowedTools "${WIKI_TOOLS[@]}" >/dev/null 2>"$WIKI_ERR" || WIKI_EXIT=$?

  if [[ $WIKI_EXIT -ne 0 ]]; then
    send_alert "$SCRIPT_NAME: Wiki Page Failed [$HOSTNAME]" \
      "Failed to create wiki page '${WIKI_ROOT_SLUG}/${WIKI_CAT_SLUG}/${WIKI_DATE_SLUG}' for category '${CATEGORY}' on $HOSTNAME. Analysis ran but results were not logged to wiki."
    echo "$(date -Iseconds) Warning: wiki page creation failed (exit $WIKI_EXIT)" >&2
    if [[ -s "$WIKI_ERR" ]]; then
      echo "$(date -Iseconds) Wiki stderr (last 20 lines):" >&2
      tail -20 "$WIKI_ERR" >&2
    fi
  else
    echo "$(date -Iseconds) Wiki page created: ${WIKI_ROOT_SLUG}/${WIKI_CAT_SLUG}/${WIKI_DATE_SLUG}"
  fi
  rm -f "$WIKI_ERR"
fi

if [[ $EXIT_CODE -ne 0 ]]; then
  exit $EXIT_CODE
fi

echo "$(date -Iseconds) $SCRIPT_NAME completed successfully"
