#!/usr/bin/env bash
#
# install-weekly-review-cron - Install a weekly cron job for weekly-pr-review.
#
# Idempotent per directory: safe to run multiple times. Will not create a
# duplicate entry if a cron job already exists for the same target directory.
#
# Usage:
#   install-weekly-review-cron <directory> <category> <day-of-week> <HH:MM>
#
# Examples:
#   install-weekly-review-cron ~/build/agents "PR Review" monday 09:00
#   install-weekly-review-cron ~/build/agents "PR Review" mon 09:00
#   install-weekly-review-cron ~/build/agents "PR Review" 1 09:00
#
# To list installed jobs:
#   crontab -l | grep weekly-pr-review
#
# To remove a job:
#   crontab -l | grep -v '<directory>' | grep -v 'weekly-pr-review' | crontab -
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REVIEW_SCRIPT="$SCRIPT_DIR/weekly-pr-review"
ENV_FILE="$(dirname "$SCRIPT_DIR")/.env"
LOG_DIR="$HOME/.local/log"

usage() {
  cat <<'EOF'
Usage: install-weekly-review-cron <directory> <category> <day-of-week> <HH:MM>

Install a weekly cron job that runs weekly-pr-review on the given directory.

Arguments:
  directory     Path to the git repository to review
  category      TaskManager category/project name (quote if it has spaces)
  day-of-week   Day to run: name (monday, mon) or number (0-6, 0=Sunday)
  HH:MM         Time to run in 24-hour format (e.g., 09:00, 15:30)

Options:
  -h, --help    Show this help

Day-of-week accepts:
  Names:   sunday, monday, tuesday, wednesday, thursday, friday, saturday
  Short:   sun, mon, tue, wed, thu, fri, sat
  Numbers: 0=Sunday, 1=Monday, ..., 6=Saturday

Only one cron job is allowed per directory. Re-running with the same
directory will report the existing job and exit without changes.

Examples:
  install-weekly-review-cron ~/build/agents "PR Review" monday 09:00
  install-weekly-review-cron ~/build/agents "PR Review" fri 14:00
  install-weekly-review-cron ~/build/taskmanager "Security" 3 10:00
EOF
  exit 0
}

# --- Parse day-of-week ---
parse_day_of_week() {
  local input="${1,,}"  # lowercase
  case "$input" in
    0|sunday|sun)     echo 0 ;;
    1|monday|mon)     echo 1 ;;
    2|tuesday|tue)    echo 2 ;;
    3|wednesday|wed)  echo 3 ;;
    4|thursday|thu)   echo 4 ;;
    5|friday|fri)     echo 5 ;;
    6|saturday|sat)   echo 6 ;;
    *)
      echo "Error: invalid day-of-week '$1'" >&2
      echo "Accepted: sunday/sun/0, monday/mon/1, tuesday/tue/2, wednesday/wed/3, thursday/thu/4, friday/fri/5, saturday/sat/6" >&2
      return 1
      ;;
  esac
}

day_name() {
  local dow="$1"
  local names=(Sunday Monday Tuesday Wednesday Thursday Friday Saturday)
  echo "${names[$dow]}"
}

# --- Parse args ---
[[ $# -eq 0 ]] && usage
[[ "$1" == "-h" || "$1" == "--help" ]] && usage

if [[ $# -lt 4 ]]; then
  echo "Error: expected 4 arguments: <directory> <category> <day-of-week> <HH:MM>" >&2
  echo "Run with --help for usage." >&2
  exit 1
fi

TARGET_DIR="$1"
CATEGORY="$2"
DAY_OF_WEEK_INPUT="$3"
TIME="$4"

# --- Validate day-of-week ---
DOW=$(parse_day_of_week "$DAY_OF_WEEK_INPUT") || exit 1
DOW_NAME=$(day_name "$DOW")

# --- Validate time format ---
if ! [[ "$TIME" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then
  echo "Error: time must be HH:MM in 24-hour format (e.g., 09:00, 15:30), got '$TIME'" >&2
  exit 1
fi

HOUR="${TIME%%:*}"
MINUTE="${TIME##*:}"

# --- Validate category (reject shell-special characters and control chars) ---
if [[ "$CATEGORY" =~ [\"\$\`\\%] ]] || [[ "$CATEGORY" == *$'\n'* ]] || [[ "$CATEGORY" == *$'\r'* ]]; then
  echo "Error: category name must not contain double quotes, dollar signs, backticks, backslashes, percent signs, or newlines" >&2
  exit 1
fi

# Strip leading zeros for cron (08 -> 8)
HOUR=$((10#$HOUR))
MINUTE=$((10#$MINUTE))

# Offset by 5 minutes to avoid collision with token refresh crons at :00/:30
MINUTE=$((MINUTE + 5))
if (( MINUTE >= 60 )); then
  MINUTE=$((MINUTE - 60))
  HOUR=$(( (HOUR + 1) % 24 ))
fi

# --- Validate directory ---
TARGET_DIR=$(realpath "$TARGET_DIR" 2>/dev/null || echo "$TARGET_DIR")
if [[ ! -d "$TARGET_DIR" ]]; then
  echo "Error: directory does not exist: $TARGET_DIR" >&2
  exit 1
fi

# --- Validate weekly-pr-review script ---
if [[ ! -f "$REVIEW_SCRIPT" ]]; then
  echo "Error: weekly-pr-review not found at $REVIEW_SCRIPT" >&2
  exit 1
fi

if [[ ! -x "$REVIEW_SCRIPT" ]]; then
  echo "Error: weekly-pr-review is not executable. Run: chmod +x $REVIEW_SCRIPT" >&2
  exit 1
fi

# --- Validate .env ---
if [[ ! -f "$ENV_FILE" ]]; then
  echo "Error: $ENV_FILE not found. Copy .env.example to .env and configure it." >&2
  exit 1
fi

if ! grep -qE '^\s*NTFY_TOKEN=.+' "$ENV_FILE"; then
  echo "Error: NTFY_TOKEN not found (or commented out) in $ENV_FILE." >&2
  exit 1
fi

# --- Check for existing job for this directory ---
CRON_MARKER="weekly-pr-review.*$(printf '%s' "$TARGET_DIR" | sed 's/[[\.*^$()+?{|]/\\&/g')"

if crontab -l 2>/dev/null | grep -qE "$CRON_MARKER"; then
  echo "Cron job already exists for $TARGET_DIR. No changes made."
  crontab -l | grep -F "$TARGET_DIR" | grep -F "weekly-pr-review"
  exit 0
fi

# --- Ensure log directory exists ---
mkdir -p "$LOG_DIR"

LOG_FILE="$LOG_DIR/weekly-pr-review.log"
touch "$LOG_FILE"
chmod 600 "$LOG_FILE"

# --- Build cron line ---
CRON_LINE="$MINUTE $HOUR * * $DOW set -a; . \"$ENV_FILE\"; set +a; export PATH=\"\$HOME/.local/bin:\$PATH\"; \"$REVIEW_SCRIPT\" \"$TARGET_DIR\" -c \"$CATEGORY\" >> \"$LOG_FILE\" 2>&1"

# --- Install ---
COMMENT="# weekly-pr-review: $CATEGORY ($TARGET_DIR) ${DOW_NAME}s at $TIME"
(crontab -l 2>/dev/null || true; echo ""; echo "$COMMENT"; echo "$CRON_LINE") | crontab -

echo "Cron job installed:"
echo "  Schedule: ${DOW_NAME}s at $TIME"
echo "  Directory: $TARGET_DIR"
echo "  Category: $CATEGORY"
echo "  Log file: $LOG_FILE"
echo ""
echo "Verify with: crontab -l | grep weekly-pr-review"
