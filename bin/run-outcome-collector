#!/usr/bin/env python3
"""CLI entry point for the Outcome Collector.

Usage:
    uv run python bin/run-outcome-collector --repos owner/repo
    uv run python bin/run-outcome-collector --repos owner/r1 owner/r2
    uv run python bin/run-outcome-collector --repos owner/repo --dry-run
"""

import argparse
import asyncio
import logging
import os
import re
import sys

# Add project root to path for imports
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from agents.outcome_collector.main import OutcomeCollector

# Suppress noisy httpx INFO logs
logging.getLogger("httpx").setLevel(logging.WARNING)


def parse_args() -> argparse.Namespace:
    """Parse CLI arguments."""
    parser = argparse.ArgumentParser(
        description="Outcome Collector — poll GitHub for PR outcomes and track patterns.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
    uv run python bin/run-outcome-collector --repos brooksmcmillin/taskmanager --dry-run
    uv run python bin/run-outcome-collector --repos owner/r1 owner/r2
""",
    )

    parser.add_argument(
        "--repos",
        nargs="+",
        default=None,
        help="GitHub repos to collect from (owner/repo format). "
        "Defaults to OUTCOME_COLLECTOR_REPOS env var.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Preview outcomes without saving to memory store",
    )

    return parser.parse_args()


async def main() -> None:
    """Main entry point."""
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s [%(levelname)s] %(name)s - %(message)s",
        datefmt="%H:%M:%S",
    )

    args = parse_args()

    if args.repos:
        for repo in args.repos:
            if not re.match(r"^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$", repo):
                print(f"Error: Invalid repo format: {repo}. Use owner/repo format.")
                sys.exit(1)

    collector = OutcomeCollector(repos=args.repos, dry_run=args.dry_run)

    try:
        outcomes = await collector.run()
        print(f"\nCollected {len(outcomes)} outcome(s):")
        for o in outcomes:
            patterns = f" patterns={o.failure_patterns}" if o.failure_patterns else ""
            print(f"  {o.repo}#{o.pr_number}: {o.pr_status}{patterns}")
    except KeyboardInterrupt:
        print("\nInterrupted.")
        sys.exit(130)


if __name__ == "__main__":
    asyncio.run(main())
