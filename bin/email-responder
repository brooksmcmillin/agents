#!/usr/bin/env bash
#
# email-responder - Check inbox for emails needing replies and save drafts.
#
# Runs the email-responder agent in one-off mode. Designed for cron/systemd
# but works fine manually too.
#
# Usage:
#   email-responder              # Check inbox, draft replies
#   email-responder --dry-run    # Print what would run without executing
#
# Sends ntfy alerts on failure when NTFY_TOKEN is configured.

set -euo pipefail

SCRIPT_NAME="email-responder"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
ENV_FILE="${PROJECT_DIR}/.env"
NTFY_URL="https://ntfy.brooksmcmillin.com/mcp-alerts"
HOSTNAME="$(hostname 2>/dev/null || cat /etc/hostname 2>/dev/null || echo 'unknown')"

# Load NTFY_TOKEN from .env if not already set
if [[ -z "${NTFY_TOKEN:-}" && -f "$ENV_FILE" ]]; then
  NTFY_TOKEN=$(grep -m1 '^NTFY_TOKEN=' "$ENV_FILE" | cut -d= -f2-)
fi

send_alert() {
  local title="$1" message="$2" priority="${3:-high}"
  if [[ -z "${NTFY_TOKEN:-}" ]]; then
    echo "Warning: NTFY_TOKEN not set, cannot send alert: $title" >&2
    return 0
  fi
  curl -sf --max-time 10 \
    -H "Authorization: Bearer ${NTFY_TOKEN}" \
    -H "Title: $title" \
    -H "Priority: $priority" \
    -H "Tags: warning" \
    -d "$message" \
    "$NTFY_URL" >/dev/null 2>&1 || echo "Warning: failed to send ntfy alert" >&2
}

usage() {
  cat <<'EOF'
Usage: email-responder [options]

Check inbox for emails needing replies and save draft responses.

Options:
  -d, --dry-run   Print the command without running it
  -h, --help      Show this help
EOF
  exit 0
}

# --- Parse args ---
DRY_RUN=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    -d|--dry-run) DRY_RUN=true; shift ;;
    -h|--help)    usage ;;
    *)            echo "Unknown option: $1" >&2; usage ;;
  esac
done

# --- Preflight ---
if [[ ! -f "$ENV_FILE" ]]; then
  echo "Error: $ENV_FILE not found. Copy .env.example to .env and configure it." >&2
  exit 1
fi

MESSAGE="Check the inbox for new and unread emails. For each email that warrants a response, \
read the full content with get_email, draft a professional reply, and save it using save_draft \
with reply_to_email_id set for proper threading. Skip newsletters, automated notifications, \
no-reply senders, and spam. Summarize what you did at the end."

CMD=(uv run python bin/run-agent email-responder -q "$MESSAGE")

if $DRY_RUN; then
  echo "Would run:"
  printf "  %q" "${CMD[@]}"
  echo ""
  exit 0
fi

echo "$(date -Iseconds) Starting $SCRIPT_NAME"
cd "$PROJECT_DIR"

EXIT_CODE=0
"${CMD[@]}" || EXIT_CODE=$?

if [[ $EXIT_CODE -ne 0 ]]; then
  send_alert "$SCRIPT_NAME: Failed [$HOSTNAME]" \
    "email-responder exited with code $EXIT_CODE on $HOSTNAME. Check journalctl -u email-responder.service"
  echo "$(date -Iseconds) Error: exited with code $EXIT_CODE" >&2
  exit $EXIT_CODE
fi

echo "$(date -Iseconds) $SCRIPT_NAME completed successfully"
